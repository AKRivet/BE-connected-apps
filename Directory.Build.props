<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisMode>Default</AnalysisMode>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Suppress missing-XML-comment warnings; add them when the API stabilises -->
    <!-- NETSDK1188: test platform locale resource files use locales not recognised by .NET 10 -->
    <NoWarn>$(NoWarn);CS1591;NETSDK1188</NoWarn>
  </PropertyGroup>

  <!-- Force Microsoft.OpenApi >= 2.0.1 globally to remediate GHSA-v5pm-xwqc-g5wc (high, affects 2.0.0) -->
  <ItemGroup>
    <PackageReference Include="Microsoft.OpenApi" />
  </ItemGroup>
</Project>
